import os
import time
from pathlib import Path
import traceback

def aguardar_download(self, extensao, downloads_formatos, arquivo_base=None, remover_originais=True, timeout=60): 
    diretorio = os.path.join(Path.home(), 'Downloads')
    
    if extensao not in downloads_formatos: 
        raise Exception(f" ❌ Extensão {extensao} não está configurada no JSON")
        
    cfg = downloads_formatos[extensao]
    if not cfg: 
        self.log(f" ❌ Extensão {extensao} não está configurada no JSON")
        return None
        
    reader_func = eval(cfg["reader"]) 
    reader_params = cfg.get("params", {}) 
    tipo_desc = cfg.get("descriptioin", f"Arquivo {extensao}")
    
    self.log(f" ⌛ Aguardando download do tipo: {extensao}... ", "INFO")
    tempo_inicial = time.time()
    
    while (time.time() - tempo_inicial) < timeout:
        try: 
            # 1. CORREÇÃO: Lê a pasta armazenando na variável com o nome certo
            todos_arquivos = os.listdir(diretorio)
            
            # 2. CORREÇÃO: Primeiro avalia se TEM arquivo temporário na pasta.
            # Se tiver, o navegador (ServiceNow) ainda está baixando. Dorme 1 seg e RECOMEÇA o loop.
            if any(f.endswith('.crdownload') or f.endswith('.tmp') or '.tmp' in f.lower() for f in todos_arquivos):
                time.sleep(1)
                continue 
            
            # 3. SE CHEGOU AQUI: Significa que NÃO há download em andamento. O terreno está limpo!
            # Agora filtramos buscando nosso arquivo alvo. Funciona no Jira e ServiceNow.
            arquivos = [f for f in todos_arquivos if f.endswith(extensao)]
            
            # Filtra pela palavra-chave, se existir
            if arquivo_base: 
                arquivos = [f for f in arquivos if arquivo_base.lower() in f.lower()]
                
            # Se o arquivo ainda não apareceu na pasta (ServiceNow demora a iniciar), volta pro loop
            if not arquivos: 
                time.sleep(1)
                continue 
                
            # 4. Encontrou o arquivo! Ordena pelo mais recente
            arquivos.sort(key=lambda x: os.path.getmtime(os.path.join(diretorio, x)), reverse=True)
            caminho = os.path.join(diretorio, arquivos[0])
            
            # 5. Tenta abrir o arquivo para garantir que o Windows já liberou da memória
            try: 
                with open(caminho, 'rb'): pass
            except IOError: 
                time.sleep(1)
                continue 
                
            # 6. Lê o arquivo usando a configuração do seu JSON (Regra mantida da V1)
            df = reader_func(caminho, **reader_params)
            
            # 7. Remove original e encerra sucesso
            if remover_originais: 
                os.remove(caminho)
                self.log(f" ✅ Arquivo carregado e removido: {os.path.basename(caminho)}", "INFO")
            else: 
                self.log(f" ✅ Arquivo carregado: {os.path.basename(caminho)}", "INFO")
                
            return df
            
        except Exception as e: 
            # BOA PRÁTICA: Exibe o erro real no console se der pau, não esconde mais!
            print(f"Erro temporário na leitura da pasta: {e}")
            time.sleep(1)
            continue
            
    # Se sair do loop WHILE, é porque o tempo acabou
    self.log( f" ❌ Timeout: O arquivo {extensao} com palavra-chave '{arquivo_base}' não apareceu a tempo", "ERROR" )
    raise TimeoutError(f"Timeout de {timeout} segundos excedido ao baixar arquivo no ServiceNow.")
